{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Native permissions shared by the main and widget windows",
  "windows": [
    "main",
    "widget"
  ],
  "permissions": [
    "core:event:allow-emit",
    "core:event:allow-listen",
    "core:event:allow-unlisten"
  ]
}
